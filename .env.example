# Copy to .env and fill in. .env is git-ignored: never commit keys.

# fake | openai | anthropic. "fake" needs no keys and is fully deterministic.
LLM_PROVIDER=fake

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Small, fast model for triage and classification; stronger model for drafting.
# Check the providers' model pages before use, since names change often.
OPENAI_TRIAGE_MODEL=gpt-5.4-mini
OPENAI_DRAFT_MODEL=gpt-5.4
ANTHROPIC_TRIAGE_MODEL=claude-haiku-5-5
ANTHROPIC_DRAFT_MODEL=claude-sonnet-5-5

# all = every outgoing action needs human approval (what the brief requires).
APPROVAL_MODE=all
# Triage results below this confidence go to the human review queue.
CONFIDENCE_THRESHOLD=0.6

# Optional: send traces to Jaeger (or any OTLP collector) as well as logs/traces.jsonl.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
